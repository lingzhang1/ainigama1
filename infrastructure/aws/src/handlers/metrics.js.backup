/**
 * Get user dashboard data (all user interactions in one call)
 * This is a performance optimization for User Center
 */
exports.getUserDashboard = async (event) => {
  try {
    const userId = event.pathParameters.userId;
    
    if (!userId) {
      return {
        statusCode: 400,
        headers: addCorsHeaders(),
        body: JSON.stringify({ error: 'User ID is required' })
      };
    }

    // Get all user data in parallel
    const [savesData, likesData, repliesData, threadsData] = await Promise.all([
      getUserSavesData(userId),
      getUserLikesData(userId), 
      getUserRepliesData(userId),
      getUserThreadsData(userId)
    ]);

    return {
      statusCode: 200,
      headers: addCorsHeaders(),
      body: JSON.stringify({
        myPosts: threadsData,
        saved: savesData,
        liked: likesData,
        replied: repliesData,
        timestamp: new Date().toISOString()
      })
    };
  } catch (error) {
    console.error('Error getting user dashboard:', error);
    return {
      statusCode: 500,
      headers: addCorsHeaders(),
      body: JSON.stringify({ error: 'Failed to get user dashboard data' })
    };
  }
};

/**
 * Get user stats only (counts without full data)
 * Ultra-fast endpoint for initial loading
 */
exports.getUserStats = async (event) => {
  try {
    const userId = event.pathParameters.userId;
    
    if (!userId) {
      return {
        statusCode: 400,
        headers: addCorsHeaders(),
        body: JSON.stringify({ error: 'User ID is required' })
      };
    }

    // Get counts only in parallel - much faster
    const [savesCount, likesCount, repliesCount, threadsCount] = await Promise.all([
      getSavesCount(userId),
      getLikesCount(userId),
      getRepliesCount(userId),
      getThreadsCount(userId)
    ]);

    return {
      statusCode: 200,
      headers: addCorsHeaders(),
      body: JSON.stringify({
        myPosts: threadsCount,
        saved: savesCount,
        liked: likesCount,
        replied: repliesCount,
        timestamp: new Date().toISOString()
      })
    };
  } catch (error) {
    console.error('Error getting user stats:', error);
    return {
      statusCode: 500,
      headers: addCorsHeaders(),
      body: JSON.stringify({ error: 'Failed to get user stats' })
    };
  }
};

// Helper function to get user's threads
async function getUserThreadsData(userId) {
  try {
    const threadsParams = {
      TableName: 'Threads',
      FilterExpression: 'creator.id = :userId',
      ExpressionAttributeValues: {
        ':userId': userId
      }
    };
    
    const threadsResult = await dynamodb.scan(threadsParams).promise();
    
    return (threadsResult.Items || []).map(thread => ({
      id: thread.id,
      type: 'question',
      title: thread.title,
      content: thread.title,
      createdAt: thread.createdAt,
      stats: { views: 0, replies: 0, likes: 0, saves: 0, shares: 0 },
      status: 'published',
      threadId: thread.id
    }));
  } catch (error) {
    console.error('Error getting user threads:', error);
    return [];
  }
}

// Helper function to get user's saves
async function getUserSavesData(userId) {
  try {
    const savesParams = {
      TableName: 'UserSaves',
      FilterExpression: 'userId = :userId',
      ExpressionAttributeValues: {
        ':userId': userId
      }
    };
    
    const savesResult = await dynamodb.scan(savesParams).promise();
    
    // Get content details for each save
    const savesWithContent = await Promise.all(
      (savesResult.Items || []).map(async (save) => {
        let content = null;
        let threadId = save.contentId;
        
        if (save.contentType === 'answer') {
          // Get answer details
          const answerParams = {
            TableName: 'Answers',
            Key: { id: save.contentId }
          };
          const answerResult = await dynamodb.get(answerParams).promise();
          if (answerResult.Item) {
            content = answerResult.Item;
            threadId = answerResult.Item.threadId;
          }
        } else if (save.contentType === 'question') {
          // Get question details
          const questionParams = {
            TableName: 'Questions',
            Key: { id: save.contentId }
          };
          const questionResult = await dynamodb.get(questionParams).promise();
          if (questionResult.Item) {
            content = questionResult.Item;
            threadId = questionResult.Item.threadId;
          }
        } else if (save.contentType === 'thread') {
          // Get thread details
          const threadParams = {
            TableName: 'Threads',
            Key: { id: save.contentId }
          };
          const threadResult = await dynamodb.get(threadParams).promise();
          if (threadResult.Item) {
            content = threadResult.Item;
          }
        }
        
        return {
          id: save.contentId,
          type: save.contentType === 'thread' ? 'question' : save.contentType,
          title: content?.title || 'Saved Content',
          content: content?.content?.substring(0, 100) || '',
          createdAt: save.timestamp,
          stats: { views: 0, replies: 0, likes: 0, saves: 0, shares: 0 },
          status: 'published',
          threadId: threadId
        };
      })
    );
    
    return savesWithContent.filter(save => save.threadId);
  } catch (error) {
    console.error('Error getting user saves:', error);
    return [];
  }
}

// Helper function to get user's likes
async function getUserLikesData(userId) {
  try {
    const likesParams = {
      TableName: 'UserLikes',
      FilterExpression: 'userId = :userId',
      ExpressionAttributeValues: {
        ':userId': userId
      }
    };
    
    const likesResult = await dynamodb.scan(likesParams).promise();
    
    // Get content details for each like
    const likesWithContent = await Promise.all(
      (likesResult.Items || []).map(async (like) => {
        let content = null;
        let threadId = like.contentId;
        
        if (like.contentType === 'answer') {
          const answerParams = {
            TableName: 'Answers',
            Key: { id: like.contentId }
          };
          const answerResult = await dynamodb.get(answerParams).promise();
          if (answerResult.Item) {
            content = answerResult.Item;
            threadId = answerResult.Item.threadId;
          }
        } else if (like.contentType === 'question') {
          const questionParams = {
            TableName: 'Questions',
            Key: { id: like.contentId }
          };
          const questionResult = await dynamodb.get(questionParams).promise();
          if (questionResult.Item) {
            content = questionResult.Item;
            threadId = questionResult.Item.threadId;
          }
        } else if (like.contentType === 'thread') {
          const threadParams = {
            TableName: 'Threads',
            Key: { id: like.contentId }
          };
          const threadResult = await dynamodb.get(threadParams).promise();
          if (threadResult.Item) {
            content = threadResult.Item;
          }
        }
        
        return {
          id: like.contentId,
          type: like.contentType === 'thread' ? 'question' : like.contentType,
          title: content?.title || 'Liked Content',
          content: content?.content?.substring(0, 100) || '',
          createdAt: like.timestamp,
          stats: { views: 0, replies: 0, likes: 0, saves: 0, shares: 0 },
          status: 'published',
          threadId: threadId
        };
      })
    );
    
    return likesWithContent.filter(like => like.threadId);
  } catch (error) {
    console.error('Error getting user likes:', error);
    return [];
  }
}

// Helper function to get user's replies
async function getUserRepliesData(userId) {
  try {
    const repliesParams = {
      TableName: 'Answers',
      FilterExpression: 'userId = :userId',
      ExpressionAttributeValues: {
        ':userId': userId
      }
    };
    
    const repliesResult = await dynamodb.scan(repliesParams).promise();
    
    return (repliesResult.Items || []).map(reply => ({
      id: reply.id,
      type: 'answer',
      title: 'Reply: ' + (reply.content?.substring(0, 50) || 'Reply'),
      content: reply.content || '',
      createdAt: reply.timestamp,
      stats: { views: 0, replies: 0, likes: 0, saves: 0, shares: 0 },
      status: 'published',
      threadId: reply.threadId
    }));
  } catch (error) {
    console.error('Error getting user replies:', error);
    return [];
  }
}

// Lightweight count functions for ultra-fast stats
async function getSavesCount(userId) {
  try {
    const params = {
      TableName: 'UserSaves',
      FilterExpression: 'userId = :userId',
      ExpressionAttributeValues: {
        ':userId': userId
      },
      Select: 'COUNT'
    };
    const result = await dynamodb.scan(params).promise();
    return result.Count || 0;
  } catch (error) {
    console.error('Error getting saves count:', error);
    return 0;
  }
}

